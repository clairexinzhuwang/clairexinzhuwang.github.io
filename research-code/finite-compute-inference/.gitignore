# Raw inputs are not redistributed; see README and real_data/data_checksums.json.
# Ignore the directory's contents rather than the directory, so the note that
# says what belongs there is still tracked: git does not descend into an
# ignored directory, so a negation for a file inside one has no effect.
real_data/data/*
!real_data/data/README.md
venv/
__pycache__/
*.pyc
.DS_Store

# fixed-B study outputs: regenerated by run_fixed_B_grid.py
# The per-replication records are evidence, not intermediates: the audit gate's
# C12 re-derives every summary row from them, and without them in the archive
# that check cannot run. 16 MB, which is worth it.
experiments_fixed_B/smoke_tests/
